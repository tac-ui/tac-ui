{
  "name": "@tac-ui/tokens",
  "version": "1.1.1",
  "description": "Design tokens for Tac UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tac-ui/tac-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://tac-ui.com",
  "bugs": "https://github.com/tac-ui/tac-ui/issues",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/css-variables.d.ts",
      "import": "./dist/web/css-variables.mjs",
      "require": "./dist/web/css-variables.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.mjs",
      "require": "./dist/native/index.js"
    }
  },
  "files": [
    "dist",
    "native"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tac-ui/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
